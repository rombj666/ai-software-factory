# ---------------------------------------------------------------------------
# AI Software Factory — environment variable template
#
# Copy this file to `.env` for local development and fill values. NEVER commit
# a `.env` file or real credentials to Git.
#
# Legend:
#   [REQUIRED-M1]  Needed by Milestone 1 code paths (app may fail loudly if missing).
#   [PLACEHOLDER]  Reserved for later milestones (M2–M8). Not used by M1 code.
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. NEON DATABASE (REQUIRED-M1)
# ---------------------------------------------------------------------------
# PostgreSQL connection string from the Neon Console → Connection Details.
# The factory app and worker both connect here; Drizzle migrations apply here.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ===========================================================================
# 2. NEON AUTH (REQUIRED-M1)
# ---------------------------------------------------------------------------
# Configure Neon Auth in the Neon Console (Authentication tab). The SDK
# (@neondatabase/auth) is built on Better Auth.
#
# NEON_AUTH_BASE_URL is shown in the Neon Console (e.g. https://<project>.neon.auth.us-west-2.aws.neon.tech)
NEON_AUTH_BASE_URL=https://YOUR-PROJECT.neon.auth.REGION.aws.neon.tech
# Long random secret used to sign session cookies (generate with: openssl rand -base64 32)
NEON_AUTH_COOKIE_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
# Public base URL exposed to the browser. Only needed for client-side SDK
# flows (popup/OAuth). Server actions in M1 use NEON_AUTH_BASE_URL directly.
NEXT_PUBLIC_NEON_AUTH_BASE_URL=https://YOUR-PROJECT.neon.auth.REGION.aws.neon.tech

# ===========================================================================
# 3. OPENAI (REQUIRED-M2 — Worker only; never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# OpenAI API key for text/coding (and later image generation). Do NOT commit.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_MAX_INPUT_TOKENS=32000
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_TIMEOUT_MS=45000
# For another model, supply ALL three verified USD / million-token rates and source.
# OPENAI_INPUT_USD_PER_MILLION=0.40
# OPENAI_CACHED_INPUT_USD_PER_MILLION=0.10
# OPENAI_OUTPUT_USD_PER_MILLION=1.60
# OPENAI_PRICING_SOURCE=https://developers.openai.com/api/docs/models/gpt-4.1-mini (verified YYYY-MM-DD)

# ===========================================================================
# 4. GITHUB (PLACEHOLDER — used by Developer Agent M5+ and Export M7)
# ---------------------------------------------------------------------------
# Personal access token with repo creation scope, or GitHub App credentials.
GITHUB_TOKEN=ghp_...
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ===========================================================================
# 5. RAILWAY (used at deploy time, see docs/architecture.md)
# ---------------------------------------------------------------------------
# Railway variables are configured per-service in the Railway dashboard.
# The repo itself only needs the values above plus the ones below.
RAILWAY_SERVICE_NAME=web|worker

# ===========================================================================
# 6. VERCEL SANDBOX (PLACEHOLDER — used by Developer Agent M5+)
# ---------------------------------------------------------------------------
# Vercel Sandbox API credentials (isolated execution of generated code).
VERCEL_SANDBOX_TOKEN=
VERCEL_SANDBOX_TEAM_ID=

# ===========================================================================
# 7. VERCEL PREVIEW (PLACEHOLDER — used by On-Demand Preview M7)
# ---------------------------------------------------------------------------
# Vercel deployment API token + project scope for temporary previews.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# ===========================================================================
# 8. PRIVATE STORAGE (OPTIONAL-M2 reference images; later M3 / M7)
# ---------------------------------------------------------------------------
# Private Vercel Blob store token on Vercel Web only. A public store is not supported.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ===========================================================================
# 9. WORKER (REQUIRED-M1 with sane defaults)
# ---------------------------------------------------------------------------
# Optional overrides for the background worker process.
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=120
WORKER_RECOVER_STALE_ON_START=true
WORKER_MAX_ATTEMPTS=3
